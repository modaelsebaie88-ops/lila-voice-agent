# Copy this file to .env and fill in the values. Never share or upload .env.

# Google Gemini API key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY

# Twilio Console home page -> "Account Info" box
TWILIO_ACCOUNT_SID=PASTE_ACCOUNT_SID
TWILIO_AUTH_TOKEN=PASTE_AUTH_TOKEN
# Your Twilio number with + and country code, no spaces, e.g. +12125551234
TWILIO_NUMBER=PASTE_YOUR_TWILIO_NUMBER

# Voice engine:
#   live  – Gemini Live native audio: Gemini hears the caller and answers in its own voice
#   relay – Twilio turns speech into text, GEMINI_MODEL replies in text, Twilio speaks it (reliable fallback)
VOICE_ENGINE=live
# Live engine model and voice (female voices: Aoede, Kore, Leda, Zephyr)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
LIVE_VOICE=Aoede
# 0 = no thinking before answering (a little faster); remove the line for the model's default
LIVE_THINKING_BUDGET=0
# true = callers can interrupt the receptionist mid-sentence; false = she always finishes speaking
ALLOW_INTERRUPTIONS=false
# Relay engine model (fast "flash" models suit phone calls)
GEMINI_MODEL=gemini-3.5-flash-lite
# Voice Twilio uses for the relay engine and for closing lines (same "Aoede" voice family)
TTS_VOICE=en-US-Chirp3-HD-Aoede

# Optional: a clinic phone to transfer callers to a real person. Leave EMPTY to take callback requests instead.
STAFF_NUMBER=

# Password for the front-desk page: https://your-link/dashboard?key=THIS
DASHBOARD_KEY=change-me

# Optional: text patients a confirmation after booking or rescheduling (sent from TWILIO_NUMBER)
SMS_CONFIRMATIONS=false

# Optional: your own phone, for "npm run call-me" (the receptionist calls you instead of you calling her)
MY_PHONE=
